# ── Нейросеть ───────────────────────────────────────────────────────────
# Вариант 1. GigaChat от Сбера: бесплатно для физлиц (365 млн токенов на 12 месяцев),
# работает из России. Ключ авторизации: developers.sber.ru → GigaChat API → проект.
LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
# Модели по очереди: когда у первой кончатся бесплатные токены, бот перейдёт на следующую.
# LLM_MODEL=GigaChat-2-Max,GigaChat-2-Pro,GigaChat-2

# Вариант 2. Любой OpenAI-совместимый API (уберите LLM_PROVIDER=gigachat выше).
# DeepSeek (дёшево, хорошо понимает русский):
#   LLM_BASE_URL=https://api.deepseek.com/v1    LLM_MODEL=deepseek-chat
LLM_API_KEY=
# OpenRouter (сотни моделей по одному ключу):
#   LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openai/gpt-4.1-mini
# Локально через LM Studio, ключ не нужен:
#   LLM_BASE_URL=http://localhost:1234/v1       LLM_MODEL=qwen2.5-7b-instruct
LLM_TEMPERATURE=0.4

# ── Telegram ────────────────────────────────────────────────────────────
# Токен бота от @BotFather: через него уходят уведомления менеджеру,
# и этот же бот может работать консультантом в Telegram.
TELEGRAM_BOT_TOKEN=
# Кому слать заказы и вызовы менеджера (Telegram ID через запятую, можно группу).
MANAGER_CHAT_IDS=
# Любая длинная случайная строка: защищает вебхук от чужих запросов.
TELEGRAM_WEBHOOK_SECRET=

# ── Память ──────────────────────────────────────────────────────────────
# Без этих переменных диалоги хранятся в памяти процесса (для локального запуска).
# На Vercel подключите Upstash Redis: Storage → Marketplace → Upstash, переменные
# KV_REST_API_URL и KV_REST_API_TOKEN появятся сами.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Лимиты (защита от счёта за API) ─────────────────────────────────────
LIMIT_PER_IP_10MIN=40
LIMIT_PER_SESSION_DAY=120
LIMIT_TOTAL_DAY=3000

# Демо-режим: посетитель видит копию уведомления, которое получил менеджер.
DEMO_MODE=true
